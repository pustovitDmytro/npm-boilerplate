{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es6",
		"outDir": "lib",
		"declaration": true,
		"rootDir": "./",
		"strict": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedParameters": true,
		"lib": ["es6"]
	},
	"typeRoots": ["node_modules/@types"],
	"exclude": ["node_modules"],
	"include": ["src"]
}